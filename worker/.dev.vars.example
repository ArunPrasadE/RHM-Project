# Copy this file to worker/.dev.vars for local development.
# Never commit .dev.vars. On Cloudflare, set these with `wrangler secret put`.

# Long random string
JWT_SECRET=

# Empty = skip the Cloudflare Access check (there is no Access locally)
ACCESS_AUD=

# Empty = writable app locally (wrangler.jsonc turns on the read-only demo mode)
READ_ONLY=
