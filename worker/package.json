{
  "name": "rhm-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Rental House Management on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:frontend": "cd ../frontend && npm install && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply rhm --local",
    "db:migrate:remote": "wrangler d1 migrations apply rhm --remote",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
